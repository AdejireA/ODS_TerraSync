# Keep real credentials in your local environment or secret manager.
TERRASYNC_DATABASE_PATH=terrasync.db
# Required in any shared deployment: signs login tokens (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
TERRASYNC_SECRET_KEY=
TERRASYNC_TOKEN_TTL_HOURS=72
# Code that lets a coordinator account register. Leave empty to disable coordinator sign-up.
TERRASYNC_COORDINATOR_CODE=
# Comma-separated frontend origins allowed by CORS.
TERRASYNC_CORS_ORIGINS=http://localhost:5173
TERRASYNC_REPORT_EXPIRY_DAYS=14
TERRASYNC_WEATHER_ENABLED=true

# Voice (API issues tokens; worker joins rooms)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TERRASYNC_VOICE_TOKEN_TTL_MINUTES=15
SPITCH_API_KEY=
# Fallback only; each browser session chooses en or yo.
TERRASYNC_VOICE_LANGUAGE=en
TERRASYNC_LLM_MODEL=google/gemma-4-31b-it
TERRASYNC_STORE_TRANSCRIPTS=true
